---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="news">
  <section class="inner-page">
      <div class="container">

        <section id="breadcrumbs" class="breadcrumbs">
          <div class="container">
            <ol>
              <li><a href="/">Home</a></li>
              <li>News</li>
            </ol>
            <h2>News</h2>
          </div>
        </section>

    <section id="blog" class="blog">
      <div class="container" data-aos="fade-up">
        <div class="row">

              <article class="col-12">
                <div class="entry">
                  <div class="entry-img">
                        <img
                          src="/img/gbbadge.webp"
                          alt="Placeholder image"
                        />
                  </div>

                  <div class="entry-meta">
                    <ul>
                      <li class="d-flex align-items-center">
                        <i class="bi bi-clock"></i>
                        <date>{new Date().toLocaleDateString()}</date>
                      </li>
                    </ul>
                  </div>

                  <h2 class="entry-title">
                        <h2>Static News Title</h2>
                  </h2>
                  
                  <div class="entry-content">
                    <p>This is a static news article. The content is hardcoded and does not come from a CMS.</p>
                  </div>
              </div>
            </article>
          </div>

        </div>
    </section>

    <!-- ======= Cta Section ======= -->
    <section id="cta" class="cta">
      <div class="container">
        <div class="text-center">
          <h3>Find your nearest club</h3>
          <p>
            Gain self-discipline, self-confidence, physical fitness, stress
            management and the ultimate form of self-defense techniques.
          </p>
          <a class="cta-btn" href="/clubs">Find a club</a>
        </div>
      </div>
    </section>
    <!-- End Cta Section -->

  </section>
</Layout>
